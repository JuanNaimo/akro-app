# Para correr el API fuera de Docker: copiar a .env y apuntar a los servicios.
# Con docker compose no hace falta: las variables se definen en docker-compose.yml.
PORT=3001
DATABASE_URL=postgresql://akro:akro@localhost:5432/akro
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=akro
S3_SECRET_KEY=akro-dev-secret
S3_BUCKET=akro
WEB_ORIGIN=http://localhost:3000
# Sin SMTP_URL los mails no se envían: se loguean en la consola del API.
# SMTP_URL=smtp://localhost:1025
MAIL_FROM=Akro <no-reply@akro.local>
