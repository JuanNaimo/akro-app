# Para correr el API fuera de Docker: copiar a .env y apuntar a los servicios.
# Con docker compose no hace falta: las variables se definen en docker-compose.yml.
PORT=3001
DATABASE_URL=postgresql://akro:akro@localhost:5432/akro
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=akro
S3_SECRET_KEY=akro-dev-secret
S3_BUCKET=akro
