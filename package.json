{
  "name": "akro",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "roadmap": "npx --yes github:SantiagoBaezDuic/roadmapper",
    "roadmap:check": "npx --yes github:SantiagoBaezDuic/roadmapper check"
  }
}
