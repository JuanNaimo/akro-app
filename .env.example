# Variables opcionales para docker compose: copiar a .env solo si hacen falta.

# Si el hot reload no detecta cambios (Docker Desktop en Windows con el repo fuera de WSL),
# activar polling. Consume bastante CPU: la mejor solución es clonar el repo dentro de WSL.
# WATCH_POLL_MS=1000
# TSC_WATCHFILE=DynamicPriorityPolling
# TSC_WATCHDIRECTORY=RecursiveDirectoryUsingDynamicPriorityPolling
